{
  "name": "techguessr",
  "account_id": "53cb4a315a12ceb1e1dd55bf34e697b7",
  "main": "./.cloudflare/worker.js",
  "build": {
    "command": "bun run build",
  },
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
